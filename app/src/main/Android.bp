package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DesktopMode",
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
    ],

    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        
        "androidx.activity_activity-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        
        "androidx.datastore_datastore-preferences",

        "VncFlinger_aidl-java",
    ],

    // OPTIONAL: If you need custom VNC aidl local compilation
    // aidl: {
    //     local_include_dirs: ["aidl"],
    // },

    kotlincflags: ["-Xjvm-default=all"],

    required: [
        "privapp_whitelist_com.libremobileos.desktopmode.xml",
        "default-permissions_com.libremobileos.desktopmode",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.libremobileos.desktopmode.xml",
    system_ext_specific: true,
    src: "privapp_whitelist_com.libremobileos.desktopmode.xml",
    sub_dir: "permissions",
}

prebuilt_etc {
    name: "default-permissions_com.libremobileos.desktopmode",
    system_ext_specific: true,
    sub_dir: "default-permissions",
    src: "default-permissions_com.libremobileos.desktopmode.xml",
    filename_from_src: true,
}
